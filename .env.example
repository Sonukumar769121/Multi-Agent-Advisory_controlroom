# LLM Provider Configuration: 'openai' or 'azure_openai'
LLM_PROVIDER=openai

# OpenAI Settings (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Azure OpenAI Settings (if LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01

# Data.gov.in Agmarknet API Key
# Register at https://data.gov.in to obtain an API key for Resource 9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_API_KEY=your-data-gov-in-api-key-here

# Control Room Timeouts & Retries
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=2
AGENT_BACKOFF_FACTOR=1.5

# Observability (OpenTelemetry)
ENABLE_OTEL_TRACING=true
OTEL_SERVICE_NAME=agricultural-advisory-control-room
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# RAG & SQLite Storage
SQLITE_DB_PATH=advisory_board.db
CHROMA_PERSIST_DIR=./chroma_db

